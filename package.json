{
  "name": "veci-reto",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:vanilla": "npm run dev --workspace @veci-reto/vanilla",
    "dev:react": "npm run dev --workspace @veci-reto/react",
    "test:vanilla": "npm run test --workspace @veci-reto/vanilla",
    "test:react": "npm run test --workspace @veci-reto/react",
    "lint": "npm run lint --workspaces",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
